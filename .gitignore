# Binaries and dumps are not versioned; hashes and manifests are.
*.bin
*.zip
*.dmg
*.exe

firmware/official/*
firmware/extracted/*
!firmware/extracted/SHA256SUMS
firmware/repacked/*
flash/*
backups/*
!**/.gitkeep
!backups/manifests/
!backups/manifests/*.json

.venv/
.work/
__pycache__/
*.pyc
.DS_Store
